# Copy to .env and fill with your own values.
# This file intentionally contains placeholders only. Never commit real credentials.

# Select one or more channels. PYPAY_CHANNEL is used by PaymentClient.from_env().
# PYPAY_CHANNELS is used by the FastAPI demo to enable multiple channels.
# Only list channels whose credentials you have configured.
PYPAY_CHANNEL=wechat
PYPAY_CHANNELS=wechat
# PYPAY_CHANNELS=wechat,alipay

# Local verification page only. Demo mode bypasses notification signatures
# and never contacts WeChat/Alipay. Keep this at 0 outside local development.
PYPAY_DEMO_MODE=0

# ---------------------------------------------------------------------------
# WeChat Pay APIv3, Native scan-code payment, WeChat Pay public key mode
# ---------------------------------------------------------------------------
PYPAY_WECHAT_MCHID=your_merchant_id
PYPAY_WECHAT_APPID=your_bound_appid
PYPAY_WECHAT_APIV3_KEY=your_32_byte_apiv3_key
PYPAY_WECHAT_CERT_SERIAL_NO=your_merchant_certificate_serial_number
PYPAY_WECHAT_PUBLIC_KEY_ID=PUB_KEY_ID_your_wechatpay_public_key_id
PYPAY_WECHAT_NOTIFY_URL=https://your-domain.example/notify/wechat
PYPAY_WECHAT_TIMEOUT=10

# Prefer key files. Inline keys are supported through the *_KEY variables.
PYPAY_WECHAT_PRIVATE_KEY_PATH=/absolute/path/to/apiclient_key.pem
PYPAY_WECHAT_PUBLIC_KEY_PATH=/absolute/path/to/wechatpay_public_key.pem
# Inline keys are also accepted as full PEM or headerless base64.
# PYPAY_WECHAT_PRIVATE_KEY=<full PEM or headerless base64>
# PYPAY_WECHAT_PUBLIC_KEY=<full PEM or headerless base64>

# ---------------------------------------------------------------------------
# Alipay PC web payment (alipay.trade.page.pay / FAST_INSTANT_TRADE_PAY)
# ---------------------------------------------------------------------------
PYPAY_ALIPAY_APPID=your_alipay_app_id
PYPAY_ALIPAY_NOTIFY_URL=https://your-domain.example/notify/alipay
PYPAY_ALIPAY_RETURN_URL=https://your-domain.example/return/alipay
PYPAY_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PYPAY_ALIPAY_TIMEOUT=10
# Optional. When set, notifications must carry the same seller_id.
PYPAY_ALIPAY_SELLER_ID=

# Prefer key files. Key files may be PKCS#1 or PKCS#8; config normalizes them
# and the adapter converts the private key to the PKCS#1 form required by the SDK.
PYPAY_ALIPAY_PRIVATE_KEY_PATH=/absolute/path/to/app_private_key.pem
PYPAY_ALIPAY_PUBLIC_KEY_PATH=/absolute/path/to/alipay_public_key.pem
# Inline keys are also accepted as full PEM or headerless base64.
# PYPAY_ALIPAY_PRIVATE_KEY=<full PEM or headerless base64>
# PYPAY_ALIPAY_PUBLIC_KEY=<full PEM or headerless base64>

# ---------------------------------------------------------------------------
# Unified payment service (pypay_service)
# ---------------------------------------------------------------------------
# The service mounts at the root of this base URL. It must be HTTPS for
# WeChat Native. Do not include a path prefix.
PYPAY_SERVICE_DATABASE_PATH=./var/pypay_service.db
PYPAY_SERVICE_PUBLIC_BASE_URL=https://pay.example.com

# Encrypts project API/notify secrets at rest. Generate 32 random bytes:
#   python -c "import base64,os; print('base64:'+base64.b64encode(os.urandom(32)).decode())"
PYPAY_SERVICE_MASTER_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES_BASE64

# Admin console login. Use a strong password and put the console behind
# HTTPS, a VPN, or your SSO/reverse proxy. The viewer role is read-only.
PYPAY_SERVICE_ADMIN_USERNAME=admin
PYPAY_SERVICE_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PYPAY_SERVICE_VIEWER_USERNAME=viewer
PYPAY_SERVICE_VIEWER_PASSWORD=replace-with-a-strong-viewer-password

# Local development only. Keep both at 0 in production.
PYPAY_SERVICE_ALLOW_HTTP_URLS=0
PYPAY_SERVICE_ALLOW_PRIVATE_URLS=0
PYPAY_SERVICE_ENABLE_DOCS=0
PYPAY_SERVICE_LOG_LEVEL=INFO

PYPAY_SERVICE_REQUEST_MAX_BYTES=262144
PYPAY_SERVICE_CLOCK_SKEW_SECONDS=300
PYPAY_SERVICE_NONCE_TTL_SECONDS=600
PYPAY_SERVICE_OUTBOX_MAX_ATTEMPTS=8
PYPAY_SERVICE_OUTBOX_TIMEOUT_SECONDS=10
PYPAY_SERVICE_OUTBOX_BATCH_SIZE=20
PYPAY_SERVICE_OUTBOX_BACKOFF_BASE_SECONDS=5
PYPAY_SERVICE_OUTBOX_LEASE_SECONDS=60
PYPAY_SERVICE_RECONCILE_GRACE_SECONDS=30
PYPAY_SERVICE_WORKER_POLL_INTERVAL_SECONDS=2
PYPAY_SERVICE_MAINTENANCE_INTERVAL_SECONDS=30

# Channel accounts the service may offer to projects. Each account reads its
# merchant credentials from the matching env prefix (the default prefix is
# PYPAY_WECHAT_ / PYPAY_ALIPAY_ as documented above). If omitted, the service
# auto-detects one default account per channel from PYPAY_WECHAT_MCHID /
# PYPAY_ALIPAY_APPID.
# PYPAY_SERVICE_CHANNEL_ACCOUNTS=[{"id":"wechat-default","channel":"wechat","name":"微信支付","env_prefix":"PYPAY_WECHAT_"},{"id":"alipay-default","channel":"alipay","name":"支付宝","env_prefix":"PYPAY_ALIPAY_"}]
#
# The service passes a per-attempt notify URL and a per-order return URL to the
# channel. The config loader still requires the channel-level NOTIFY_URL and
# (for Alipay) RETURN_URL variables above, so point them at the service domain:
# PYPAY_WECHAT_NOTIFY_URL=https://pay.example.com/notify/wechat/wechat-default
# PYPAY_ALIPAY_NOTIFY_URL=https://pay.example.com/notify/alipay/alipay-default
# PYPAY_ALIPAY_RETURN_URL=https://pay.example.com/pay/return/alipay
# The Alipay RETURN_URL above is only a placeholder: each order uses
# https://pay.example.com/pay/{token}/return/alipay instead.
